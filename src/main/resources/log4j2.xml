<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%c{0}:%L %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>

<!--        <Root level="warn">-->
<!--            <AppenderRef ref="Console"/>-->
<!--        </Root>-->
        <Root level="debug">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>

        <Logger name="util.SessionListener"
                level="warn"/>

        <Logger name="org.springframework.core.LocalVariableTableParameterNameDiscoverer"
                level="error"/>
        <Logger name="org.springframework.beans.factory.support.DefaultListableBeanFactory" level="warn"/>
        <Logger name="org.springframework.context.annotation.ClassPathBeanDefinitionScanner" level="warn"/>
        <Logger name="org.hibernate.id" level="warn"/>
        <Logger name="org.hibernate.boot" level="warn"/>

    </Loggers>
</Configuration>